# ---------------------------------------------------------------------------
# Smart Waste Management System - Backend environment configuration
# Copy this file to `.env` and replace every value marked CHANGE_ME.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database
# Local:  mongodb://127.0.0.1:27017/smart_waste_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_waste_db?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/smart_waste_db

# ---------------------------------------------------------------------------
# Authentication
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# CORS - comma separated list of allowed browser origins
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Uploads
MAX_FILE_UPLOAD_MB=5
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# AI waste verification (TensorFlow.js MobileNet when available, jimp heuristic otherwise)
# ---------------------------------------------------------------------------
AI_VERIFY_ENABLED=true
AI_MIN_CONFIDENCE=60
AI_REJECT_INVALID=false

# ---------------------------------------------------------------------------
# Email notifications (SMTP). Leave SMTP_HOST empty to disable real sending:
# notifications are then logged to the console instead of failing.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Waste Management System <no-reply@swms.gov>"

# Seed script defaults (see `npm run seed`)
SEED_ADMIN_EMAIL=admin@swms.gov
SEED_ADMIN_PASSWORD=Admin@123
SEED_WORKER_EMAIL=worker@swms.gov
SEED_WORKER_PASSWORD=Worker@123
SEED_USER_EMAIL=user@swms.gov
SEED_USER_PASSWORD=User@123
