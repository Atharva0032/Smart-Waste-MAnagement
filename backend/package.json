{
  "name": "smart-waste-backend",
  "version": "1.0.0",
  "description": "REST API for the Smart Waste Management System (MERN) - citizen reporting, AI image verification, worker assignment and municipal analytics.",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:memory": "node dev-memory.js",
    "seed": "node seed.js",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('uploads',{recursive:true});\""
  },
  "keywords": [
    "mern",
    "waste-management",
    "express",
    "mongodb",
    "tensorflow"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.15"
  },
  "optionalDependencies": {
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs-node": "^4.22.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4"
  }
}
